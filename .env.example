# Copiá este archivo como .env y completá los valores.
# IMPORTANTE: usá el MISMO DATABASE_URL en todas las PCs para ver los mismos
# usuarios, boliches y reservas (base en Supabase, en la nube).

DATABASE_URL="postgresql://usuario:password@host:5432/postgres?sslmode=require"

# Opcional en desarrollo (hay default)
JWT_SECRET="cambiar-en-produccion"
JWT_EXPIRES_IN="7d"
PORT=3000
NODE_ENV=development

# Opcional
RESERVATION_TTL_MINUTES=10
LOYALTY_CURRENCY_PER_POINT=100
